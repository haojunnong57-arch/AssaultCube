+// Native iOS layer: hardware keyboard/mouse forwarding + input blocking while
+// the UIKit settings sheet is on screen. Declared here (not in core/input.h)
+// because that header is included inside the touchui struct below.
+extern void keypress(int code, bool isdown, int cooked, SDL_Keymod mod);
+extern void mousemove(int dx, int dy);
+#ifdef __APPLE__
+extern "C" int ac_ios_input_blocked;
+#else
+static int ac_ios_input_blocked = 0;
+#endif
+
 VARP(onboarded, 0, 0, 1); // determines if the onboarding process has been completed
 VARP(touchoptionsanimation, 0, 1, 4 ); // show touchui options 0:linear, ease1-4
 VARP(touchoptionsanimationduration, 0, 500, 5000 ); // 0:off
 VARP(touchattackcontrol, 0, 0, 2); // determines the attack control, 0:double tap, 1:volume-up key, 2:button
 VARP(touchjumpcontrol, 0, 0, 1); // determines the jump control, 0:swipe, 1:button
+// iOS native layer: mirrored layout (joystick on the right, look-drag on the left)
+VARP(ioslefthanded, 0, 0, 1);
 
 // ATM we only have voicecom options toggled in game@scoreboard scene
