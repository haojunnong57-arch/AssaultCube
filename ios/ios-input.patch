diff --git a/source/src/touch/touch.cpp b/source/src/touch/touch.cpp
index d9dbbfd..16d7d03 100644
--- a/source/src/touch/touch.cpp
+++ b/source/src/touch/touch.cpp
@@ -27,11 +27,24 @@ extern bool sentvoicecom_public;
